{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://surgical-ai.org/schemas/coordinator-output.json",
  "title": "StructuredEvidenceBrief",
  "description": "Comprehensive synthesized surgical evidence brief generated by the Coordinator Agent",
  "type": "object",
  "properties": {
    "research_question": {
      "type": "string",
      "description": "Normalized surgical research question"
    },
    "research_scope": {
      "type": "object",
      "description": "Structured PICOT decomposition of the research topic",
      "properties": {
        "population": {
          "type": "string",
          "description": "Target surgical patient population (e.g. adult elective colorectal patients)"
        },
        "context": {
          "type": "string",
          "description": "Clinical or operational setting (e.g. inpatient elective surgical units)"
        },
        "intervention_exposure": {
          "type": "string",
          "description": "Intervention, exposure, or protocol evaluated (e.g. multimodal prehabilitation)"
        },
        "comparator": {
          "type": "string",
          "description": "Comparator or control group (e.g. standard perioperative care or unassisted preop)"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Primary and secondary clinical, functional, or economic endpoints"
        },
        "time_range": {
          "type": "string",
          "description": "Temporal scope or publication window of interest"
        }
      },
      "required": [
        "population",
        "context",
        "intervention_exposure",
        "comparator",
        "outcomes"
      ],
      "additionalProperties": false
    },
    "not_found": {
      "type": "object",
      "description": "Explicit status flags indicating whether evidence or guidelines were absent",
      "properties": {
        "evidence_not_found": {
          "type": "boolean",
          "description": "True if no peer-reviewed studies met the search criteria"
        },
        "guidelines_not_found": {
          "type": "boolean",
          "description": "True if no official society guidelines or consensus statements met the search criteria"
        },
        "details": {
          "type": "string",
          "description": "Detailed explanation of absent or unverified data"
        }
      },
      "required": ["evidence_not_found", "guidelines_not_found"],
      "additionalProperties": false
    },
    "evidence_findings": {
      "type": "object",
      "description": "Synthesized scholarly literature findings from the Evidence Agent",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Synthesized narrative of clinical trial and review findings"
        },
        "key_study_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "study_title": {
                "type": "string"
              },
              "authors_or_organization": {
                "type": "string"
              },
              "publication_year": {
                "type": "integer"
              },
              "evidence_type": {
                "type": "string"
              },
              "primary_endpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "key_findings": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "study_title",
              "authors_or_organization",
              "publication_year",
              "evidence_type",
              "key_findings",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["summary", "key_study_findings"],
      "additionalProperties": false
    },
    "guideline_findings": {
      "type": "object",
      "description": "Synthesized society and regulatory recommendations from the Guideline Agent",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Synthesized perspective on institutional and society recommendations"
        },
        "guideline_statements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "organization": {
                "type": "string"
              },
              "guideline_title": {
                "type": "string"
              },
              "publication_or_update_year": {
                "type": "integer"
              },
              "recommendation_summary": {
                "type": "string"
              },
              "strength_of_recommendation": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "organization",
              "guideline_title",
              "publication_or_update_year",
              "recommendation_summary",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["summary", "guideline_statements"],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "description": "Exhaustive deduplicated registry of all verified sources cited in the brief",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "description": "Unique citation reference (e.g. 'SRC-01')"
          },
          "title": {
            "type": "string",
            "description": "Full formal title of the publication or guideline document"
          },
          "author_or_institution": {
            "type": "string",
            "description": "Lead author or issuing organization"
          },
          "year": {
            "type": "integer",
            "description": "Publication year"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "systematic_review",
              "randomized_trial",
              "observational_study",
              "practice_guideline",
              "consensus_statement",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Verified direct link"
          }
        },
        "required": [
          "source_id",
          "title",
          "author_or_institution",
          "year",
          "source_type",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "areas_of_agreement": {
      "type": "array",
      "description": "Specific domains where clinical trials and professional guidelines converge in consensus",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Clinical domain (e.g., Preoperative exercise benefit on functional capacity)"
          },
          "consensus_summary": {
            "type": "string",
            "description": "Summary of aligned evidence and guideline recommendations"
          },
          "supporting_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Referenced source_ids"
          }
        },
        "required": ["domain", "consensus_summary"],
        "additionalProperties": false
      }
    },
    "areas_of_disagreement": {
      "type": "array",
      "description": "Points of divergence between clinical trials and guidelines, or between conflicting guidelines",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string",
            "description": "Core conflict or divergent recommendation"
          },
          "divergence_description": {
            "type": "string",
            "description": "Explanation of differing viewpoints, methodologies, or cutoff thresholds"
          },
          "conflicting_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Referenced source_ids representing opposing stances"
          }
        },
        "required": ["issue", "divergence_description"],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "description": "Areas where evidence remains inconclusive, underpowered, or inconsistent",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "uncertainty_rationale": {
            "type": "string"
          }
        },
        "required": ["topic", "uncertainty_rationale"],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "description": "Methodological, geographic, and design limitations across reviewed materials",
      "items": {
        "type": "string"
      }
    },
    "discussion_questions": {
      "type": "array",
      "description": "Educational prompts and research questions proposed for surgeon workshop discussion",
      "items": {
        "type": "string"
      }
    },
    "safety_disclaimer": {
      "type": "string",
      "description": "Mandatory standard safety disclaimer: Educational and research synthesis only, not clinical decision support or medical advice"
    }
  },
  "required": [
    "research_question",
    "research_scope",
    "not_found",
    "evidence_findings",
    "guideline_findings",
    "sources",
    "areas_of_agreement",
    "areas_of_disagreement",
    "uncertainty",
    "limitations",
    "discussion_questions",
    "safety_disclaimer"
  ],
  "additionalProperties": false
}
