# ==============================================================================
# Surgical AI Agents - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Note: .env is ignored by Git. DO NOT commit secrets, credentials, or private IDs.
# ==============================================================================

# Google Cloud Project ID (Vertex AI backend)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Location / Region
# Note: Gemini 3.8 Flash is served from multi-region 'us' or 'global' on Vertex AI.
GOOGLE_CLOUD_LOCATION=us

# Model Identifier
# Default ADK reference model: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional: Google GenAI Vertex AI mode toggle (default: true in codebase)
# GOOGLE_GENAI_USE_VERTEXAI=true
